# Port for the HTTP server. This is the port number on which the frontend server will run.
HTTP_PORT=

# Base URL for the API. This is the base endpoint for the backend API that the frontend will communicate with.
VITE_API_BASE_URL=http://localhost:3001

# Token for API authentication. This token is used to authenticate requests to the backend API.
VITE_API_TOKEN=

# Environment ID. This is the ID of the environment that the frontend will run in. For local development, this can be set to "dev" or the username of the developer.
ENVIRONMENT_ID=

# Base URL for the Playwright tests. This is the base endpoint for the frontend that the Playwright tests will run against.
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
