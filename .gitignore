!.gitignore
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency directories
node_modules

# Output directories
dist
dist-ssr
coverage

# Local environment files
*.local

# Playwright test results
test-results/
playwright-report/

# Editor directories and files
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript build info
*.tsbuildinfo

# Vue specific files
*.env.local
*.env.*.local
.env
.env.*.local
!.env.example
